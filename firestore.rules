rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function teamDoc() {
      return get(/databases/$(database)/documents/settings/team);
    }

    function isHardcodedAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          "shekohitler@gmail.com",
          "Martin.magdy109@gmail.com",
          "shadywaheed10101@gmail.com"
        ] ||
        request.auth.uid in [
          "ADMIN_UID_1",
          "ADMIN_UID_2"
        ]
      );
    }

    function canDeleteHymns() {
      return isSignedIn() && (
        request.auth.token.email in [
          "shekohitler@gmail.com"
        ] ||
        request.auth.uid in [
          "DELETE_UID_1"
        ]
      );
    }

    function canModifyHymns() {
      return isSignedIn() && isHardcodedAdmin();
    }

    function canManageTeam() {
      return isSignedIn() && isHardcodedAdmin();
    }

    function exclusiveReadAllowed() {
      return !resource.data.isExclusive ||
        resource.data.exclusiveOwnerUid == request.auth.uid;
    }

    function isValidSharedSetlist() {
      return request.resource.data.schemaVersion == 1 &&
        request.resource.data.name is string &&
        request.resource.data.hymnIds is list &&
        request.resource.data.ownerUid is string &&
        request.resource.data.createdBy is string &&
        request.resource.data.updatedBy is string;
    }

    match /hymns/{hymnId} {

      allow read: if resource == null || exclusiveReadAllowed();

      allow create: if isSignedIn() &&
        canModifyHymns() &&
        request.resource.data.title is string &&
        request.resource.data.key is string &&
        request.resource.data.sections is list &&
        (
          !request.resource.data.isExclusive ||
          request.resource.data.exclusiveOwnerUid == request.auth.uid
        );

      allow update: if isSignedIn() &&
        canModifyHymns() &&
        request.resource.data.title is string &&
        request.resource.data.key is string &&
        request.resource.data.sections is list &&
        (
          !request.resource.data.isExclusive ||
          request.resource.data.exclusiveOwnerUid == request.auth.uid
        );

      allow delete: if canDeleteHymns();
    }

    match /setlists/{setlistId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        canModifyHymns() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.updatedBy == request.auth.uid &&
        isValidSharedSetlist();

      allow update: if isSignedIn() &&
        canModifyHymns() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.updatedBy == request.auth.uid &&
        isValidSharedSetlist();

      allow delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        canDeleteHymns()
      );
    }

    match /settings/{docId} {

      allow read: if isSignedIn();

      allow create, update: if isSignedIn() &&
        canManageTeam();

      allow delete: if false;
    }
  }
}